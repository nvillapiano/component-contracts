{
  "name": "component-contracts",
  "version": "0.0.1",
  "private": true,
  "description": "Design system component contract repository",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter mcp-server dev",
    "dev:wc": "pnpm --filter @ds/web-components dev",
    "dev:mcp": "pnpm --filter @ds/mcp-server dev",
    "dev:web": "pnpm --filter @ds/web dev",
    "kill:web": "lsof -ti :6006 | xargs kill 2>/dev/null || true",
    "reset:web": "pnpm run kill:web ; pnpm run dev:web",
    "full-reset:web": "pnpm --filter @ds/schema build && pnpm --filter @ds/contracts build && pnpm tokens:build && pnpm reset:web",
    "dev:tokens": "pnpm --filter @ds/tokens dev",
    "validate": "pnpm --filter @ds/validator start",
    "validate:tokens": "bash scripts/validate-component-tokens.sh",
    "validate:token-coverage": "tsx scripts/validate-token-coverage.ts",
    "export-figma-references": "tsx scripts/export-figma-references.ts",
    "build:figma-tokens": "tsx scripts/build-figma-tokens.ts",
    "build:figma-component": "tsx scripts/build-figma-component.ts",
    "types:generate": "pnpm --filter @ds/schema generate",
    "tokens:build": "pnpm --filter @ds/tokens build",
    "test": "pnpm --filter @ds/web test",
    "test:ci": "pnpm --filter @ds/web test:ci",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/node": "^20.0.0",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
