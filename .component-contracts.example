# Component Contracts Configuration
#
# Copy this file to .component-contracts and fill in your values
# This file is used by the Figma token and component builders
#
# DO NOT commit .component-contracts to version control
# Add it to .gitignore to keep credentials safe

# Figma API Configuration
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token_here
FIGMA_FILE_KEY=your_figma_file_key_here

# Directory Configuration
# Paths are relative to project root
TOKENS_DIR=packages/tokens/src
CONTRACTS_DIR=packages/contracts/src

# Example values:
# FIGMA_ACCESS_TOKEN=figd_1234567890abcdefghijklmnop
# FIGMA_FILE_KEY=1Ab2Cd3Ef4Gh5Ij6Kl7Mn8Op9Qr0St
# TOKENS_DIR=packages/tokens/src
# CONTRACTS_DIR=packages/contracts/src
