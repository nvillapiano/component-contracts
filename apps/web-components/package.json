{
  "name": "@ds/web-components",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc && vite build",
    "build:storybook": "storybook build",
    "demo": "vite --open demo/index.html",
    "test": "storybook build && npx http-server storybook-static -p 6006 --silent & npx wait-on http://127.0.0.1:6006 && test-storybook; kill %1",
    "test:ci": "test-storybook"
  },
  "dependencies": {
    "@ds/contracts": "workspace:*",
    "@ds/tokens": "workspace:*",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "lucide-static": "^0.577.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/test": "8.6.18",
    "@storybook/test-runner": "^0.19.0",
    "@storybook/web-components": "8.6.18",
    "@storybook/web-components-vite": "8.6.18",
    "@types/node": "^20.0.0",
    "http-server": "^14.1.0",
    "storybook": "8.6.18",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  }
}
